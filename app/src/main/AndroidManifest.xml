<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <attribution
        android:label="@string/app_name"
        android:tag="audio_playback" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForeverJukebox"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.foreverjukebox.app.cast.ForeverJukeboxCastOptionsProvider" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The foreverjukebox.com/listen deep link is server-mode only and
                 lives in the `full` flavor manifest (src/full/AndroidManifest.xml).
                 The `play` flavor is local-only and intentionally has no App Links. -->
        </activity>
        <service
            android:name=".playback.ForegroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <!-- Required: set your sentry.io project identifier (DSN) -->
        <meta-data android:name="io.sentry.dsn" android:value="https://a6537a45657a1fc1b95e640f6e67b030@o4511598611464192.ingest.us.sentry.io/4511598611595264" />
        <!-- Do not send user PII (IP address, device name, request headers) with events -->
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />
        <!-- Attach the UI layout tree to crashes for debugging (no user content / screenshot) -->
        <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />
        <!-- Enable structured logs (Sentry.logger()) for recoverable, non-fatal failures -->
        <meta-data android:name="io.sentry.logs.enabled" android:value="true" />
    </application>
</manifest>
