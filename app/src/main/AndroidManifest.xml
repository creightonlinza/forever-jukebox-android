<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- firebase-analytics pulls in advertising-ID and ad-attribution permissions by
         default. The app has no ads, purchases, or attribution needs, so they are
         removed to keep the advertising ID out of the data the app collects.
         Paired with google_analytics_adid_collection_enabled below. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />

    <attribution
        android:label="@string/app_name"
        android:tag="audio_playback" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForeverJukebox"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.foreverjukebox.app.cast.ForeverJukeboxCastOptionsProvider" />
        <!-- Stops Analytics from reading the advertising ID at runtime; the
             matching permissions are removed above. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The foreverjukebox.com/listen deep link and the share-sheet
                 targets are server-mode only and live in the `full` flavor
                 manifest (src/full/AndroidManifest.xml). The `play` flavor is
                 local-only and intentionally has neither. -->
        </activity>
        <!--
          Hardware and Bluetooth media keys reach the app through this pair. Without
          them the only route is winning the system's "media button session" slot,
          which a session earns by actually playing — so a notification showing a
          play button for something that has not played yet (a freshly loaded track,
          a failed load offering Retry, a service restarted while paused) would get
          no response from a headset. The receiver also gives MediaSessionCompat a
          media button PendingIntent, which is what lets keys restart playback after
          the service is gone.
        -->
        <service
            android:name=".playback.ForegroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <!-- Exported because the media key broadcast is sent by the system. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
